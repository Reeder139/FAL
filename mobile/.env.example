# Copy to .env and fill in. Every EXPO_PUBLIC_* value is inlined into the
# client bundle at build time — these are public by definition, so never put
# a secret behind that prefix. The Supabase service_role key in particular
# must never appear here or anywhere in this app.
EXPO_PUBLIC_SUPABASE_URL=https://heplwptnonxfxvobjnri.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public origin this build is served from, no trailing slash. Drives the
# absolute URLs in the web app manifest and the password-reset redirect.
#
# Leave unset for local dev and for preview deployments: the manifest then
# uses relative paths (valid on any origin) and password reset falls back to
# the Site URL configured in the Supabase dashboard.
#
# Whatever you set here MUST also be on Supabase's redirect allow-list under
# Authentication -> URL Configuration, or password reset will break.
EXPO_PUBLIC_SITE_URL=
